# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=

# Gemini model name. If Google retires it, check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Optional limits
MAX_UPLOAD_MB=25
MAX_PAGES_PER_DOC=500
SCANNED_MIN_CHARS_PER_PAGE=50
LLM_TIMEOUT_SECONDS=60
MAX_LLM_CHARS=120000

# OCR (for scanned pages)
OCR_DPI=200
OCR_MAX_PAGES=50

# RAG settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_RELEVANCE=0.20
